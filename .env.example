# Veridexa AI — environment variables (BLUEPRINT.md Section S)
#
# Copy the backend block into backend/.env and the frontend block into
# frontend/.env.local for local dev. Neither .env file is ever committed
# (see .gitignore). In production, set these as dashboard env vars on
# Render/Railway (backend) and Vercel (frontend) instead of shipping files.

# ---- Backend (backend/.env) ----------------------------------------------
# Every var below is optional locally — leave any of them truly empty (just
# `KEY=`, nothing after the `=`, not even a trailing comment on the same
# line) and the app degrades gracefully. Do NOT put a comment after `=` on
# the same line as an empty value: pydantic-settings' dotenv loader keeps
# the "# comment text" itself as the value instead of treating it as empty,
# which crashes asyncpg on DATABASE_URL specifically ("invalid DSN: scheme
# is expected to be either postgresql or postgres, got ''") and silently
# sends a garbage bearer token for GITHUB_TOKEN. Comments live on their own
# line above the var instead, for exactly this reason.
ANTHROPIC_API_KEY=
# read-only PAT, public_repo scope
GITHUB_TOKEN=
SUPABASE_URL=
# backend only — never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=
# asyncpg connection string, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000,https://<vercel-domain>

# ---- Frontend (frontend/.env.local) ---------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
