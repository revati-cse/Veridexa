# Veridexa AI — environment variables (BLUEPRINT.md Section S)
#
# Copy the backend block into backend/.env and the frontend block into
# frontend/.env.local for local dev. Neither .env file is ever committed
# (see .gitignore). In production, set these as dashboard env vars on
# Render/Railway (backend) and Vercel (frontend) instead of shipping files.

# ---- Backend (backend/.env) ----------------------------------------------
ANTHROPIC_API_KEY=
GITHUB_TOKEN=                # read-only PAT, public_repo scope
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # backend only — never expose to the frontend
DATABASE_URL=                # asyncpg connection string, e.g. postgresql://user:pass@host:5432/db
ALLOWED_ORIGINS=http://localhost:3000,https://<vercel-domain>

# ---- Frontend (frontend/.env.local) ---------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
